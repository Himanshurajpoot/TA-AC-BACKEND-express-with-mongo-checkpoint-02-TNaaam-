<%- include("./partials/header") %>

<main class="main-content">

>


  <!-- Update Event Form -->
  <section class="form-section">
    <h2>Update Event</h2>

    <form action="/events/<%= event.id %>" method="POST" enctype="multipart/form-data" class="form-card">

      <!-- Title -->
      <label for="title">Title</label>
      <input type="text" name="title" value="<%= event.title %>" required />

      <!-- Summary -->
      <label for="summary">Summary</label>
      <textarea name="summary" rows="3" required><%= event.summary %></textarea>

      <!-- Image -->
      <label for="cover_image">Cover Image</label>
      <% if (event.cover_image) { %>
        <img src="/images/<%= event.cover_image %>" alt="Cover Image" class="event-image-preview" />
      <% } %>
      <input type="file" name="cover_image">

      <!-- Host + Location -->
      <div class="form-row">
        <div>
          <label for="host">Host</label>
          <input type="text" name="host" value="<%= event.host %>" required />
        </div>
        <div>
          <label for="location">Location</label>
          <input type="text" name="location" value="<%= event.location %>" required />
        </div>
      </div>

      <!-- Dates -->
      <div class="form-row">
        <div>
          <label for="start_date">Start Date</label>
          <input type="date" name="start_date" 
            value="<%= event.start_date ? new Date(event.start_date).toISOString().split('T')[0] : '' %>" 
            required />
        </div>
        <div>
          <label for="end_date">End Date</label>
          <input type="date" name="end_date" 
            value="<%= event.end_date ? new Date(event.end_date).toISOString().split('T')[0] : '' %>" 
            required />
        </div>
      </div>

      <!-- Categories -->
      <label for="categories">Event Categories</label>
      <% let selectedCategories = event.categories || []; %>
      <select name="categories" multiple required>
        <option value="programming" <%= selectedCategories.includes("programming") ? "selected" : "" %>>Programming</option>
        <option value="sports" <%= selectedCategories.includes("sports") ? "selected" : "" %>>Sports</option>
        <option value="trekking" <%= selectedCategories.includes("trekking") ? "selected" : "" %>>Trekking</option>
        <option value="music" <%= selectedCategories.includes("music") ? "selected" : "" %>>Music</option>
        <option value="education" <%= selectedCategories.includes("education") ? "selected" : "" %>>Education</option>
      </select>

      <!-- Submit -->
      <input type="submit" value="Update Event" class="submit-btn" />
    </form>
  </section>

</main>

<%- include("./partials/footer") %>
